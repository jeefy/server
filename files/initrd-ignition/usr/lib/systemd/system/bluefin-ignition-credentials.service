[Unit]
Description=Ignition config from system credentials
Documentation=man:systemd.system-credentials(7) https://coreos.github.io/ignition/
Documentation=file:/usr/libexec/bluefin-ignition-credentials
ConditionPathExists=/etc/initrd-release
# Opt-in: Ignition only runs with an ignition.config / ignition.config.url
# system credential (SMBIOS type 11, fw_cfg, ESP /loader/credentials), or on a
# UEFI HTTP boot whose server offers bluefin-node.ign next to the UKI.
ConditionCredential=|ignition.config
ConditionCredential=|ignition.config.url
ConditionPathExists=|/sys/firmware/efi/efivars/StubDeviceURL-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
DefaultDependencies=no
# The HTTP-boot lookup needs the network; the disk UKI masks
# systemd-networkd-wait-online, so this costs installed nodes nothing.
Wants=network-online.target
After=basic.target network-online.target
Before=ignition-complete.target

# Stage order: credentials -> fetch-offline [-> fetch] -> disks -> mount -> files.
Before=ignition-fetch-offline.service

OnFailure=emergency.target
OnFailureJobMode=isolate

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=ignition.config*
ExecStart=/usr/libexec/bluefin-ignition-credentials
