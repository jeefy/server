#!/usr/bin/bash
# bluefin-update-status — update health on the login banners.
#
# Run by bluefin-update-status.service at boot and after every run of
# systemd-sysupdate.service (OnSuccess=/OnFailure=, from
# systemd-sysupdate.service.d/30-update-status.conf). It records the outcome
# of the newest systemd-sysupdate.service run in
# /var/lib/bluefin-update-status/state, so the last successful check and the
# last error survive reboots, and writes the same lines to
#   /run/issue.d/40-bluefin-update.issue  the console banner (agetty)
#   /run/motd                             login and sshd, through /etc/motd
# : the running version, whether automatic updates are on, the last
# successful check, a staged update, and the error of the newest check while
# no later check has succeeded.
#
# It only reads local state (unit properties, the journal of the failed run,
# the UKIs on the ESP) and never fetches anything. It always exits 0: a
# failed check stays visible as the failed systemd-sysupdate.service.
#
# Test overrides: BLUEFIN_SYSTEMCTL, BLUEFIN_JOURNALCTL, BLUEFIN_OS_RELEASE,
# BLUEFIN_BOOT_PATH, BLUEFIN_UPDATE_STATE_DIR, BLUEFIN_ISSUE_FILE,
# BLUEFIN_MOTD_FILE, BLUEFIN_AGETTY.

set -uo pipefail
export LC_ALL=C

systemctl="${BLUEFIN_SYSTEMCTL:-systemctl}"
journalctl="${BLUEFIN_JOURNALCTL:-journalctl}"
os_release="${BLUEFIN_OS_RELEASE:-/usr/lib/os-release}"
state_dir="${BLUEFIN_UPDATE_STATE_DIR:-${STATE_DIRECTORY:-/var/lib/bluefin-update-status}}"
issue="${BLUEFIN_ISSUE_FILE:-/run/issue.d/40-bluefin-update.issue}"
motd="${BLUEFIN_MOTD_FILE:-/run/motd}"
agetty="${BLUEFIN_AGETTY:-agetty}"
unit=systemd-sysupdate.service

last_success="" last_error="" error="" recorded=""
if [ -r "${state_dir}/state" ]; then
    while IFS='=' read -r key value; do
        case "${key}" in
            last_success | last_error | error | recorded) printf -v "${key}" '%s' "${value}" ;;
        esac
    done < "${state_dir}/state"
fi

# One line, no control characters, at most 160 characters.
oneline() { tr -d '\000-\037\177' | cut -c1-160; }

# The reason a run failed, from the errors it logged: systemd-pull logs the
# cause first ("Signature verification failed.", "Transfer failed: ...",
# "HTTP request to ... failed with code 404."), systemd-sysupdate the
# consequence after it.
failure() {
    local errors first
    errors="$("${journalctl}" -q -o cat --no-pager -p err "_SYSTEMD_INVOCATION_ID=$1" 2>/dev/null)"
    first="$(printf '%s\n' "${errors}" | grep -m1 . | oneline)"
    if printf '%s\n' "${errors}" | grep -qiE 'signature|gpg|keyring'; then
        echo "signature verification failed${first:+ (${first})}"
    elif printf '%s\n' "${errors}" | grep -qiE 'transfer failed|HTTP|resolve|connect|refused|timed? ?out|unreachable|network'; then
        echo "update source unreachable${first:+ (${first})}"
    else
        echo "${first:-${unit} failed with result $2}"
    fi
}

# Record the newest finished run once.
invocation="$("${systemctl}" show -P InvocationID "${unit}" 2>/dev/null)"
active="$("${systemctl}" show -P ActiveState "${unit}" 2>/dev/null)"
finished="$("${systemctl}" show -P ExecMainExitTimestamp --timestamp=unix "${unit}" 2>/dev/null)"
finished="${finished#@}"
if [ -n "${invocation}" ] && [ "${invocation}" != "${recorded}" ] && [ -n "${finished}" ] \
    && { [ "${active}" = inactive ] || [ "${active}" = failed ]; }; then
    result="$("${systemctl}" show -P Result "${unit}" 2>/dev/null)"
    if [ "${result}" = success ]; then
        last_success="${finished}"
    else
        last_error="${finished}"
        error="$(failure "${invocation}" "${result}")"
    fi
    recorded="${invocation}"
    if mkdir -p "${state_dir}" \
        && printf 'last_success=%s\nlast_error=%s\nerror=%s\nrecorded=%s\n' \
            "${last_success}" "${last_error}" "${error}" "${recorded}" > "${state_dir}/state.tmp" \
        && mv -f "${state_dir}/state.tmp" "${state_dir}/state"; then
        :
    else
        echo "could not record the update check in ${state_dir}" >&2
    fi
fi

booted=""
if [ -r "${os_release}" ]; then
    while IFS='=' read -r key value; do
        [ "${key}" = IMAGE_VERSION ] || continue
        value="${value%\"}"; value="${value#\"}"
        booted="${value}"
    done < "${os_release}"
fi

# A UKI newer than the booted one is staged; one with no tries left
# (bluefin-server-<ver>+0[-<done>].efi) already failed its boot tries.
staged="" rejected=""
boot="${BLUEFIN_BOOT_PATH:-$(bootctl --print-boot-path 2>/dev/null || echo /boot)}"
for uki in "${boot}"/EFI/Linux/bluefin-server-*.efi; do
    [ -e "${uki}" ] && [ -n "${booted}" ] || continue
    name="${uki##*/bluefin-server-}"
    version="${name%.efi}"
    version="${version%%+*}"
    systemd-analyze compare-versions "${version}" gt "${booted}" > /dev/null 2>&1 || continue
    case "${name}" in
        *+0.efi | *+0-*.efi) rejected="${version}" ;;
        *) staged="${version}" ;;
    esac
done

when() { date -d "@$1" '+%Y-%m-%d %H:%M %Z' 2>/dev/null || echo "@$1"; }

timer="$("${systemctl}" is-enabled systemd-sysupdate.timer 2>/dev/null)"
if [ "${timer}" = enabled ]; then
    updates="automatic updates on"
else
    updates="automatic updates off (systemd-sysupdate.timer is ${timer:-missing})"
fi

failing=0
if [ -n "${last_error}" ] && { [ -z "${last_success}" ] || [ "${last_error}" -gt "${last_success}" ]; }; then
    failing=1
fi

check="never"
[ -z "${last_success}" ] || check="$(when "${last_success}")"
if [ -n "${staged}" ]; then
    check="${check}; ${staged} staged, it boots at the next reboot"
elif [ -n "${rejected}" ]; then
    check="${check}; ${rejected} failed its boot tries, staying on ${booted}"
elif [ -n "${last_success}" ] && [ "${failing}" = 0 ]; then
    check="${check}, up to date"
fi

lines=("Bluefin Server ${booted:-unknown}, ${updates}" "Last update check: ${check}")
if [ "${failing}" = 1 ]; then
    lines+=("Last update check FAILED $(when "${last_error}"): ${error}")
    lines+=("  journalctl -u ${unit}")
fi

# write <file> <content>: replace atomically.
write() {
    mkdir -p "${1%/*}" && printf '%s\n' "$2" > "$1.tmp" && chmod 0644 "$1.tmp" && mv -f "$1.tmp" "$1" \
        || echo "could not write $1" >&2
}
text="$(printf '%s\n' "${lines[@]}")"
# agetty expands backslash escapes in issue files.
write "${issue}" "${text//\\/\\\\}"$'\n'
write "${motd}" "${text}"$'\n'
"${agetty}" --reload > /dev/null 2>&1 || true
exit 0
