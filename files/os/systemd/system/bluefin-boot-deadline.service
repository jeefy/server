[Unit]
Description=Reboot a Boot-Counted Boot That Missed boot-complete.target
Documentation=file:/usr/libexec/bluefin-boot-deadline man:systemd-bless-boot.service(8)
ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
ConditionPathExists=!/run/machines/rootdisk.raw
ConditionKernelCommandLine=!root=tmpfs
# Not ordered after basic.target, multi-user.target or boot-complete.target:
# the deadline must still fire when the boot hangs before any of them.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/bluefin-boot-deadline
# The fleet reboot lock (bluefin-reboot-lock): exit 75 means no FleetLock slot
# was free. Try again, re-checking the boot first, until one is; other
# failures do not restart.
ImportCredential=bluefin.reboot-lock.*
RestartForceExitStatus=75
RestartSec=5min
