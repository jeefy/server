# Automatic updates (docs/skills/ddi-installer.md, "Updates").
# Installed nodes download a new release into the inactive slot and reboot
# into it in the nightly window; Kubernetes nodes leave the reboot to kured.
# Drop-ins condition both timers off on diskless and USB installer boots.
enable systemd-sysupdate.timer
enable systemd-sysupdate-reboot.timer
# Boot health gate: boot-complete.target, and with it systemd-bless-boot
# marking a boot-counted UKI good, requires that no unit has failed.
enable systemd-boot-check-no-failures.service
# Diskless nodes flag /run/reboot-required when their boot server offers a
# newer release; the timer is conditioned off everywhere else.
enable bluefin-diskless-update-check.timer
